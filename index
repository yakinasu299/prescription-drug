  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --main-green: #48bb78;
      --main-green-light: #e6fffa;
      --main-green-dark: #2f855a;
      --sub-blue: #4299e1;
      --sub-blue-light: #ebf8ff;
      --bg-gradient: linear-gradient(135deg, #f0fff4 0%, #ebf8ff 100%);
      --text-color: #2d3748;
      --text-muted: #718096;
      --danger-color: #ed8936;
      --danger-bg: #fffaf0;
      --danger-border: #fbd38d;
      --card-bg: #ffffff;
      --border-color: #e2e8f0;
      --radius: 12px;
      --shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Noto Sans JP', sans-serif;
    }

    body {
      background: var(--bg-gradient);
      color: var(--text-color);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* Header Styling */
    header {
      text-align: center;
      margin-top: 20px;
      margin-bottom: 30px;
    }
    .header-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background-color: var(--main-green-light);
      color: var(--main-green-dark);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 500;
      margin-bottom: 12px;
    }
    h1 {
      font-size: 1.8rem;
      color: var(--text-color);
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    /* Main Card (Search Area) */
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 30px;
      border: 1px solid rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(10px);
      margin-bottom: 30px;
    }

    .search-wrapper {
      position: relative;
    }

    .search-input-container {
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-icon {
      position: absolute;
      left: 16px;
      color: var(--sub-blue);
      pointer-events: none;
    }

    .clear-btn {
      position: absolute;
      right: 14px;
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      display: none;
      padding: 4px;
      border-radius: 50%;
    }
    .clear-btn:hover { background-color: #edf2f7; }

    input[type="text"] {
      width: 100%;
      padding: 16px 44px 16px 48px;
      font-size: 1.1rem;
      border: 2px solid var(--border-color);
      border-radius: 10px;
      outline: none;
      transition: all 0.2s ease;
      background-color: #f7fafc;
    }

    input[type="text"]:focus {
      border-color: var(--main-green);
      background-color: #fff;
      box-shadow: 0 0 0 3px rgba(72, 187, 120, 0.2);
    }

    /* Auto-complete Dropdown */
    .autocomplete-list {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      max-height: 280px;
      overflow-y: auto;
      z-index: 100;
      display: none;
    }

    .autocomplete-item {
      padding: 12px 18px;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #f7fafc;
      transition: background-color 0.15s;
    }
    .autocomplete-item:last-child { border-bottom: none; }
    .autocomplete-item:hover, .autocomplete-item.active {
      background-color: var(--main-green-light);
    }

    .item-name {
      font-weight: 500;
      color: var(--text-color);
    }
    .item-brand {
      font-size: 0.85rem;
      color: var(--text-muted);
      background: #edf2f7;
      padding: 2px 8px;
      border-radius: 4px;
    }

    /* Result Box */
    .result-container {
      margin-top: 24px;
      display: none;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .result-box {
      border-radius: 10px;
      padding: 20px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .result-box.allowed {
      background-color: var(--main-green-light);
      border: 1px solid #b2f5ea;
      color: var(--main-green-dark);
    }

    .result-box.denied {
      background-color: var(--danger-bg);
      border: 1px solid var(--danger-border);
      color: #c05621;
    }

    .result-title {
      font-size: 1.3rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .result-drug-name {
      font-size: 0.95rem;
      margin-top: 4px;
      font-weight: 500;
      opacity: 0.9;
    }

    .result-notice {
      margin-top: 8px;
      padding: 10px 14px;
      background: rgba(255, 255, 255, 0.7);
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 500;
      color: #9c4221;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Admin Drawer Footer */
    footer {
      margin-top: auto;
      padding-top: 20px;
      text-align: center;
    }

    .admin-toggle-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 0.85rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 20px;
      transition: all 0.2s;
    }
    .admin-toggle-btn:hover {
      background-color: rgba(0, 0, 0, 0.04);
      color: var(--text-color);
    }

    /* Admin Panel */
    .admin-panel {
      display: none;
      margin-top: 15px;
      background: #fff;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 24px;
      text-align: left;
      border: 1px solid var(--border-color);
    }
    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border-color);
    }
    .admin-title {
      font-weight: 700;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .admin-form {
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      gap: 10px;
      margin-bottom: 20px;
    }
    .admin-input {
      padding: 10px;
      font-size: 0.9rem;
      border: 1px solid var(--border-color);
      border-radius: 6px;
    }
    .btn {
      padding: 10px 16px;
      border-radius: 6px;
      border: none;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.9rem;
      transition: opacity 0.2s;
    }
    .btn:hover { opacity: 0.9; }
    .btn-primary { background-color: var(--main-green); color: white; }
    .btn-secondary { background-color: #edf2f7; color: var(--text-color); }
    .btn-danger { background-color: #e53e3e; color: white; padding: 6px 10px; font-size: 0.8rem; }

    .drug-list-container {
      max-height: 220px;
      overflow-y: auto;
      border: 1px solid var(--border-color);
      border-radius: 6px;
    }
    .drug-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
    }
    .drug-table th, .drug-table td {
      padding: 10px 12px;
      text-align: left;
      border-bottom: 1px solid #edf2f7;
    }
    .drug-table th {
      background-color: #f7fafc;
      color: var(--text-muted);
      position: sticky;
      top: 0;
    }

    .admin-footer-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 15px;
    }

    .notice-box {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 10px;
      line-height: 1.4;
    }

    /* Responsive */
    @media (max-width: 600px) {
      .admin-form {
        grid-template-columns: 1fr;
      }
      .card {
        padding: 20px 16px;
      }
      h1 { font-size: 1.4rem; }
    }
  </style>
</head>
<body>

