      const query = searchInput.value.trim();
      const normQuery = normalizeText(query);

      clearBtn.style.display = query ? 'block' : 'none';

      if (!normQuery) {
        autocompleteList.style.display = 'none';
        resultContainer.style.display = 'none';
        return;
      }

      // 予測候補の検索（処方可能リスト ＋ 不可参考リスト両方から探索）
      const candidates = [];

      allowedDrugs.forEach(d => {
        const normGen = normalizeText(d.generic);
        const normBrand = normalizeText(d.brand);
        if (normGen.includes(normQuery) || normBrand.includes(normQuery)) {
          candidates.push({ ...d, type: 'allowed' });
        }
      });

      REFERENCE_DENIED_DRUGS.forEach(d => {
        const normGen = normalizeText(d.generic);
        const normBrand = normalizeText(d.brand);
        if (normGen.includes(normQuery) || normBrand.includes(normQuery)) {
          // 重複がなければ追加
          if (!candidates.some(c => c.generic === d.generic)) {
            candidates.push({ ...d, type: 'denied' });
          }
        }
      });

      renderAutocomplete(candidates);
    }

    function renderAutocomplete(candidates) {
      if (candidates.length === 0) {
        autocompleteList.style.display = 'none';
        return;
      }

      autocompleteList.innerHTML = candidates.map((item, index) => `
        <div class="autocomplete-item" data-index="${index}">
          <span class="item-name">${escapeHtml(item.generic)}</span>
          <span class="item-brand">${escapeHtml(item.brand)}</span>
        </div>
      `).join('');

      autocompleteList.style.display = 'block';

      // クリックイベント設定
      document.querySelectorAll('.autocomplete-item').forEach((el, idx) => {
        el.addEventListener('click', () => {
          const selected = candidates[idx];
          searchInput.value = selected.brand ? `${selected.generic} (${selected.brand})` : selected.generic;
          autocompleteList.style.display = 'none';
          evaluateDrug(selected.generic, selected.brand, selected.type);
        });
      });
    }

    // 判定・結果表示処理
    function evaluateDrug(genericName, brandName, forceType = null) {
      let isAllowed = false;
      let displayDrug = genericName;

      if (brandName) {
        displayDrug += ` （${brandName}）`;
      }

      if (forceType) {
        isAllowed = (forceType === 'allowed');
      } else {
        const queryNorm = normalizeText(genericName);
        isAllowed = allowedDrugs.some(d => 
          normalizeText(d.generic) === queryNorm || 
          normalizeText(d.brand).includes(queryNorm)
        );
      }

      renderResult(isAllowed, displayDrug);
    }

    function renderResult(isAllowed, drugName) {
      resultContainer.style.display = 'block';
      if (isAllowed) {
        resultContainer.innerHTML = `
          <div class="result-box allowed">
            <div class="result-title">
              <i data-lucide="check-circle-2" size="28"></i> 当院処方可能です
            </div>
            <div class="result-drug-name">対象：${escapeHtml(drugName)}</div>
          </div>
        `;
      } else {
        resultContainer.innerHTML = `
          <div class="result-box denied">
            <div class="result-title">
              <i data-lucide="alert-triangle" size="28"></i> 当院処方が原則不可な薬です
            </div>
            <div class="result-drug-name">対象：${escapeHtml(drugName)}</div>
            <div class="result-notice">
              <i data-lucide="info" size="16"></i> 処方が必要と判断した場合は、カルテ内にその理由を記載してください
            </div>
          </div>
        `;
      }
      lucide.createIcons();
    }

    // Enterキー入力での直接判定
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const query = searchInput.value.trim();
        if (!query) return;

        autocompleteList.style.display = 'none';

        // 登録されているかチェック
        const normQuery = normalizeText(query);
        const matchAllowed = allowedDrugs.find(d => 
          normalizeText(d.generic) === normQuery || 
          normalizeText(d.brand).includes(normQuery)
        );

        if (matchAllowed) {
          evaluateDrug(matchAllowed.generic, matchAllowed.brand, 'allowed');
        } else {
          const matchDenied = REFERENCE_DENIED_DRUGS.find(d =>
            normalizeText(d.generic) === normQuery || 
            normalizeText(d.brand).includes(normQuery)
          );
          if (matchDenied) {
            evaluateDrug(matchDenied.generic, matchDenied.brand, 'denied');
          } else {
            evaluateDrug(query, '', 'denied');
          }
        }
      }
    });

    searchInput.addEventListener('input', handleSearchInput);

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      clearBtn.style.display = 'none';
      autocompleteList.style.display = 'none';
      resultContainer.style.display = 'none';
      searchInput.focus();
    });

    // 画面外クリックでドロップダウン閉じる
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.search-wrapper')) {
        autocompleteList.style.display = 'none';
      }
    });

    // ==========================================
    // 5. 管理機能（追加・削除・初期化）
    // ==========================================
    adminToggleBtn.addEventListener('click', () => {
      const isVisible = adminPanel.style.display === 'block';
      adminPanel.style.display = isVisible ? 'none' : 'block';
      if (!isVisible) {
        renderAdminTable();
      }
    });

    function renderAdminTable() {
      adminDrugTableBody.innerHTML = allowedDrugs.map((d, index) => `
        <tr>
          <td>${escapeHtml(d.generic)}</td>
          <td>${escapeHtml(d.brand || '-')}</td>
          <td>
            <button class="btn btn-danger" onclick="deleteDrug(${index})">
              <i data-lucide="trash-2" size="12"></i> 削除
            </button>
          </td>
        </tr>
      `).join('');
      lucide.createIcons();
    }

    addDrugForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const generic = document.getElementById('addGenericName').value.trim();
      const brand = document.getElementById('addBrandName').value.trim();

      if (generic) {
        allowedDrugs.unshift({ generic, brand });
        saveData();
        document.getElementById('addGenericName').value = '';
        document.getElementById('addBrandName').value = '';
      }
    });

    window.deleteDrug = function(index) {
      if (confirm(`「${allowedDrugs[index].generic}」を処方可能リストから削除しますか？`)) {
        allowedDrugs.splice(index, 1);
        saveData();
      }
    };

    resetDefaultBtn.addEventListener('click', () => {
      if (confirm('薬剤マスターリストを初期状態（105薬）に戻しますか？追加した薬剤は消去されます。')) {
        allowedDrugs = [...DEFAULT_ALLOWED_DRUGS];
        saveData();
      }
    });

    // アイコン初期描画
    lucide.createIcons();
  </script>
</body>
</html>
